// Serial (VP-65).  It can no longer go over USB-C: 69 is the FPGA's TX to
// the on-board BL616 and MiSTeryNano spends it on spi_irqn, and 70 is that
// BL616's TX, which would fight an external adapter.  Both ends move to the
// header pins upstream reserves for exactly this, 48 out and 55 in.
IO_LOC "uart_tx" 48;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
