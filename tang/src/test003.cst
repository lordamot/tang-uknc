// MCU link - stock MiSTeryNano wiring.  External BL616 / M0S Dock only:
//   m0s[0] miso  m0s[1] mosi  m0s[2] csn  m0s[3] sclk  m0s[4] irqn
IO_LOC "m0s[0]" 42;
IO_PORT "m0s[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "m0s[1]" 41;
IO_PORT "m0s[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "m0s[2]" 56;
IO_PORT "m0s[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "m0s[3]" 54;
IO_PORT "m0s[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "m0s[4]" 51;
IO_PORT "m0s[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// The Tang Nano 20k's own on-board BL616 is NOT used.  MiSTeryNano can
// drive it over 86/13/76/75/69, and this core did between 30 August 2026
// and the same afternoon, but pin 69 is the FPGA's TX into that BL616 -
// the USB-C serial console - and upstream spends it on the SPI interrupt.
// The internal path was never exercised on hardware here and it costs the
// console, so it is gone and those five pads are free.  Restoring it means
// taking 69 back off uart_tx.

// Audio - moved off 51/54/55/56, which the m0s bus now owns.
IO_LOC "HP_BCK" 71;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "HP_WS" 72;
IO_PORT "HP_WS" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "HP_DIN" 73;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "PA_EN" 74;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sdclk" 83;
IO_PORT "sdclk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// Serial (VP-65), over USB-C.  69 is the FPGA's TX into the on-board BL616
// and 70 is that BL616's TX back, so with the stock Sipeed firmware in it
// the console is the USB-C CDC port and needs no adapter.  Upstream
// reserves header pins 48 and 55 for a USB-UART instead; that is the
// arrangement to go back to if 69 is ever wanted for the SPI interrupt.
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
